<form id="bonus-roll-form">

    <div class="">

        <div class="">
            <label>{{localize 'glyphes.roll.difficulte.select_type'}}</label>
            <select name="typeDifficulte">
                {{#each difficultes as |difficulte| }}
                    <option value="{{difficulte.value}}" {{#if difficulte.isDefault}}selected{{/if}}>{{localize (concat 'glyphes.common.difficulte.' @key)}}</option>
                {{/each}}
            </select>
        </div>

        <div class="">
            <label>{{localize 'glyphes.roll.glyphe.nb_des'}}</label>
            <input type="number" name="nbDe" value="1" step="1" />
        </div>

        <div class="roll-threshold">
            <label>{{localize 'glyphes.roll.glyphe.nb_des_rituels'}}</label>
            <input type="number" name="nbDeBonus" value="0" step="1" />
        </div>


    </div>
</form>