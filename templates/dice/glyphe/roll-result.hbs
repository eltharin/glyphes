<div class="dice-roll" data-action="expandRoll">
    <div class="dice-result">
        <div class="dice-formula">{{title}} ({{competence.titre}})</div>
        {{{tooltip}}}
        
        <div class="dice-formula">{{localize "glyphes.roll.result.difficulte" difficulte=difficulte}}</div>
        
        <div class="dice-total">{{total}} Réussite(s)</div>
        <div class="dice-total">{{echecs}} Echec(s)</div>
        <div class="dice-formula">{{nbdepairimpair.pair}} dés pairs</div>
        <div class="dice-formula">{{nbdepairimpair.impair}} dés impaires</div>

        <h4 class="dice-total">{{totalpts}} pts d'immersion</h4>

    </div>
</div>
<div class="dice-roll-actions">
        {{#if canAffectTempete}}
            {{#if (not alreadyAffectTempete)}}
                <div class="button" data-action="affectTempete" data-nbechecs="{{echecs}}" data-actor="{{actor}}">{{localizeSystem 'roll.glyphe.result.appliqueTempete' nbPts=nbTempete}}</div>
            {{/if}}
        {{/if}}


        {{#if hasEffect}}
            {{#if (not alreadyRollEffect)}}
                <div class="button" data-action="rollEvocationEffect" data-nbechecs="{{echecs}}" data-actor="{{actor}}">{{localizeSystem 'roll.glyphe.result.lancerEffet'}}</div>
            {{/if}}
        {{/if}}
</div>